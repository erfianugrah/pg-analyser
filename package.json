{
  "name": "pg-analyser",
  "version": "0.10.1",
  "description": "Postgres performance analysis tool - Supabase-native (PAT-only) or any Postgres via superuser connstring; generates self-contained HTML + PDF reports",
  "license": "MIT",
  "author": "Erfi Anugrah",
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "pg-analyser": "src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "check": "biome check --write .",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check:alerts": "bun run scripts/check-alerts-drift.ts",
    "check:api": "bun run scripts/check-api-drift.ts",
    "check:inspect": "bun run scripts/check-inspect-drift.ts",
    "check:lints": "bun run scripts/check-lints-drift.ts",
    "check:pgversions": "bun run scripts/check-pgversions-drift.ts",
    "check:schemas": "bun run scripts/check-schemas-drift.ts",
    "check:docurls": "bun run scripts/check-docurls.ts",
    "smoke": "bun run smoke.ts",
    "build": "bun build ./src/index.ts --compile --outfile pg-analyser",
    "test:live": "bun acceptance/live-sql.ts && bun acceptance/live-catalogue-sql.ts && bun acceptance/live-promtool.ts"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@types/bun": "1.3.14",
    "typescript": "^5"
  }
}
